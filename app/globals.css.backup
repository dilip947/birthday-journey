@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --background: #0d0b0f;
  --foreground: #f8f1e8;
}

* {
  box-sizing: border-box;
}

html {
  background: var(--background);
}

body {
  margin: 0;
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
}

::selection {
  background: #e9a8b5;
  color: #0d0b0f;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 9999;
  opacity: 0.035;
  background-image: url("/textures/grain.png");
  mix-blend-mode: screen;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

.fun-time {
  margin-top: 55px;
  padding: 0 0 55px;
}

.fun-time-card {
  width: 100%;
  min-height: 125px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 24px 30px;

  border: 1px solid #302b31;
  border-radius: 22px;

  background: #121013;
  color: #fff;

  cursor: pointer;

  transition:
    transform 0.25s ease,
    border-color 0.25s ease,
    background 0.25s ease;

  box-sizing: border-box;
}

.fun-time-card:hover {
  transform: translateY(-3px);
  border-color: #514651;
  background: #151216;
}

.fun-time-icon {
  width: 54px;
  height: 54px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid #493e46;
  border-radius: 50%;

  color: #ed7896;
  font-size: 23px;

  flex-shrink: 0;
}

.fun-time-content {
  flex: 1;
  text-align: center;
}

.fun-time-content p {
  margin: 0 0 5px;

  color: #817783;

  font-size: 8px;
  letter-spacing: 4px;
}

.fun-time-content h2 {
  margin: 0;

  color: #f1dfe5;

  font-family:
    "Cormorant Garamond",
    Georgia,
    serif;

  font-size: 32px;
  font-weight: 500;
}

.fun-time-content span {
  display: block;

  margin-top: 5px;

  color: #817783;

  font-size: 10px;
}

.fun-time-arrow {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid #302b31;
  border-radius: 50%;

  color: #c8aab4;

  font-size: 17px;

  flex-shrink: 0;
}

@media (max-width: 600px) {
  .fun-time-card {
    padding: 22px 18px;
  }

  .fun-time-content h2 {
    font-size: 28px;
  }

  .fun-time-content span {
    font-size: 9px;
  }
}